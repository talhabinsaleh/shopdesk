# Copy this file to .env in the project root and fill it in.
# server/ reads all of these. client/ only needs API_URL.

# ---- server (Express API) ----
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net
DB_NAME=shopdesk
PORT=5000

# BetterAuth: the WEBSITE's address (logins go through it) and any long random string
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=any-long-random-string

# Optional: Google login (the Google button only shows when these are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: free key from https://api.imgbb.com for image uploads (image URLs work without it)
IMGBB_API_KEY=

# ---- client (Next.js website) ----
# Where the Express API runs
API_URL=http://localhost:5000
